rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Add the first five admin documents from Firebase Console, not from the client app.
      allow create, update, delete: if isAdmin();
    }
    match /residents/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /garages/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /fundTransactions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
